# just a flag
ENV = 'development'

# ==========================================
# API 配置说明
# ==========================================
# 后端 API 地址 - 通过 docker-compose 环境变量动态注入
# 实际值由根目录 .env 文件中的 SERVER_HOST 和 BACKEND_PORT 决定
# 如果环境变量未设置，则使用下面的默认值

# 这里不写死 VUE_APP_BASE_API 和 VUE_APP_BASE_IMG_URL。
# 否则 vue.config.js 会把 127.0.0.1:8002 直接编译进前端代码，
# 即使根目录 .env 的 SERVER_HOST 已经改成实际服务器 IP，也会继续请求 127.0.0.1:8002。
# 前端会优先使用 VUE_APP_SERVER_PROTOCOL + VUE_APP_SERVER_HOST + VUE_APP_BACKEND_PORT
# 动态生成 API 地址；这些值由根目录 docker-compose-dev.yml 注入。

# ==========================================
# 注意事项
# ==========================================
# 1. 开发环境下，这些值会被 docker-compose-dev.yml 中的环境变量覆盖
# 2. 修改服务器地址请编辑根目录的 .env 文件中的 SERVER_HOST
# 3. 修改端口请编辑根目录的 .env 文件中的 BACKEND_PORT
