# just a flag
ENV = 'development'

# ==========================================
# API 配置说明
# ==========================================
# 后端 API 地址 - 通过 docker-compose 环境变量动态注入
# 实际值由根目录 .env 文件中的 SERVER_HOST 和 BACKEND_PORT 决定
# 如果环境变量未设置，则使用下面的默认值

# base api - 后端 API 地址
# 格式: ${SERVER_PROTOCOL}://${SERVER_HOST}:${BACKEND_PORT}
VUE_APP_BASE_API = 'http://127.0.0.1:8002'

# image base url - 图片资源地址
# 格式: ${SERVER_PROTOCOL}://${SERVER_HOST}:${BACKEND_PORT}/media/
VUE_APP_BASE_IMG_URL = 'http://127.0.0.1:8002/media/'

# ==========================================
# 注意事项
# ==========================================
# 1. 开发环境下，这些值会被 docker-compose-dev.yml 中的环境变量覆盖
# 2. 修改服务器地址请编辑根目录的 .env 文件中的 SERVER_HOST
# 3. 修改端口请编辑根目录的 .env 文件中的 BACKEND_PORT
