# just a flag
ENV = 'production'

# ==========================================
# API 配置说明
# ==========================================
# 生产环境使用 Nginx 反向代理
# 所有 /prod-api/ 请求会被 Nginx 转发到后端服务

# base api - 后端 API 地址 (通过 Nginx 反向代理)
VUE_APP_BASE_API = '/prod-api'

# image base url - 图片资源地址 (通过 Nginx 反向代理)
VUE_APP_BASE_IMG_URL = '/media/'

# ==========================================
# 注意事项
# ==========================================
# 1. 生产环境下，API 请求通过 Nginx 反向代理
# 2. Nginx 配置文件位于 frontend/nginx/default.conf
# 3. 如需修改后端地址，请编辑 Nginx 配置中的 proxy_pass
