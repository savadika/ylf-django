# 复制为 .env 后填写实际配置

# 容器名称
MYSQL_CONTAINER_NAME=framework-mysql
BACKEND_CONTAINER_NAME=framework-django
FRONTEND_CONTAINER_NAME=framework-vue
REDIS_CONTAINER_NAME=framework-redis

# 服务器访问地址
SERVER_HOST=127.0.0.1
SERVER_PROTOCOL=http

# 端口
FRONTEND_DEV_PORT=9530
FRONTEND_DEV_INTERNAL_PORT=9528
FRONTEND_PORT=9530
FRONTEND_INTERNAL_PORT=80
BACKEND_PORT=8002
BACKEND_INTERNAL_PORT=8000
MYSQL_PORT=3309
MYSQL_INTERNAL_PORT=3306
REDIS_PORT=6380
REDIS_INTERNAL_PORT=6379

# 数据库
MYSQL_DATABASE=framework
MYSQL_ROOT_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# Django
DJANGO_SECRET_KEY=
# JWT 专用签名密钥（必须与 DJANGO_SECRET_KEY 不同；生产环境务必填写）
JWT_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LANGUAGE_CODE=zh-hans
# 可信反向代理层数（生产 Nginx 前为 1，开发直连为 0）
TRUSTED_PROXY_COUNT=0

# CORS（直接运行 Django 时使用；Docker Compose 已在编排中单独指定）
CORS_ORIGIN_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://127.0.0.1:9530,http://localhost:9530
CORS_ALLOW_CREDENTIALS=False
